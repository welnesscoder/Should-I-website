# Public site URL, used for canonical links, OG metadata, and sitemap generation.
NEXT_PUBLIC_SITE_URL=https://sayless.app

# Supabase project (service role key is server-only — never expose it to the client).
# Voting, trending, and the daily question all degrade to safe empty states when unset.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only salt used to hash the anonymous per-browser vote fingerprint cookie.
VOTE_FINGERPRINT_SALT=
